# CẤU HÌNH SERVER
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# SUPABASE (Lấy tại: Supabase Dashboard → Project Settings → Data API)
SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# GOOGLE OAUTH (Lấy tại: Google Cloud Console → APIs & Services → Credentials)
GOOGLE_CLIENT_ID=YOUR_CLIENT_ID.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-YOUR_SECRET
GOOGLE_REDIRECT_URI=http://localhost:5000/api/auth/google/callback

# BẢO MẬT (Tự tạo chuỗi ngẫu nhiên, bảo mật)
# Gợi ý lệnh tạo: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=paste-your-32-byte-hex-key-here
JWT_SECRET=paste-your-random-jwt-secret-here
